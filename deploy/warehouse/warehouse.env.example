# Copy to deploy/warehouse/warehouse.env for local overrides.
# Do not commit real credentials.

CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.3
# Canonical market-data database. Migration metadata is stored separately in warehouse.
CLICKHOUSE_DB=market
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
# Keep defaults local-only. For another Docker Compose project to reach ClickHouse through the
# host gateway on Linux, bind the HTTP port to the Docker bridge address, for example 172.17.0.1.
# CLICKHOUSE_HTTP_HOST=172.17.0.1
# CLICKHOUSE_NATIVE_HOST=172.17.0.1

CLICKHOUSE_MEM_LIMIT=4g
CLICKHOUSE_CPUS=2
