[Unit]
Description=Nautilus Alpaca options runner (%i)
Documentation=file:%h/Projects/nautilus_trader/docs/developer_guide/alpaca_nuc_deployment.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/nautilus_trader
Environment=NAUTILUS_ALPACA_ACCOUNT=%i
Environment=NAUTILUS_ALPACA_ENV_FILE=%h/.config/nautilus-trader/alpaca/accounts/%i.env
Environment=NAUTILUS_ALPACA_SERVICE=alpaca-options@%i.service
Environment=NAUTILUS_ALPACA_REPO=%h/Projects/nautilus_trader
Environment=NAUTILUS_ALPACA_RUNNER_BIN=%h/.local/bin/alpaca-options-node
Environment=NAUTILUS_ALPACA_OPERATOR_BIN=%h/.local/bin/alpaca-ops
Environment=NAUTILUS_ALPACA_LOG_DIR=%h/.local/state/nautilus_trader/alpaca/%i/logs
Environment=NAUTILUS_ALPACA_LOCK_DIR=%h/.local/state/nautilus_trader/alpaca/%i/locks
Environment=ALPACA_CONFIG_PATH=%h/.config/nautilus-trader/alpaca/configs/%i-options.toml
EnvironmentFile=%h/.config/nautilus-trader/alpaca/accounts/%i.env
ExecStart=%h/.local/bin/alpaca-options-runner
Restart=on-failure
RestartSec=30
TimeoutStopSec=30
KillSignal=SIGTERM

# Keep the service scoped to the user account and avoid accidental privilege expansion.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
