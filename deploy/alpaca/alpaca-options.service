[Unit]
Description=Nautilus Alpaca options runner
Documentation=file:%h/Projects/nautilus_trader/docs/developer_guide/alpaca_nuc_deployment.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/nautilus_trader
EnvironmentFile=%h/.config/nautilus-trader/alpaca/options-engine.env
ExecStart=%h/.local/bin/alpaca-options-runner
Restart=on-failure
RestartSec=30
TimeoutStopSec=30
KillSignal=SIGTERM

# Keep the service scoped to the user account and avoid accidental privilege expansion.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
