# Copy to ~/.config/nautilus-trader/alpaca/configs/paper-put-credit-spy-options.toml.
# Profile manifest: deploy/alpaca/alpaca-paper-profiles.tsv profile_id=put_credit_spy_strict backtest_profile=put_credit_spy_strict.
# Isolated paper profile for the SPY put-credit candidate validated by historical sweeps.

extends = "../base-options.toml"

[runtime]
open_orders = true
close_orders = true
state_path = "/home/ade/.local/state/nautilus_trader/alpaca/paper-put-credit-spy/strategy_state.json"

[[strategies]]
id = "put_credit_spy_strict"
family = "put_credit"
mode = "live"
underlyings = ["SPY"]
quantity = 1

[strategies.scanner]
min_return_on_risk = 0.16

[universe]
entry_start = "09:45"
entry_end = "10:15"

[management]
profit_target_close_fraction = 0.50
stop_loss_close_multiple = 2.0
max_hold_secs = 14400
expiration_exit_days = 1

[risk]
max_active_entries = 1
max_daily_submits = 1
max_open_orders = 2
max_active_entries_per_underlying = 1
max_active_entries_per_sector = 1
