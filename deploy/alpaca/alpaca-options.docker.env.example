# Copy or merge this into the repo-local .env, then pass it with:
#   docker compose --env-file .env -f deploy/alpaca/compose.yml ...
#
# Do not commit real credentials.

# Alpaca paper credentials.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Paper endpoints by default. Change only when intentionally moving to live.
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_TRADE_UPDATES_WS_URL=wss://paper-api.alpaca.markets/stream

# Docker build defaults prioritize local rollout speed. Runtime images include the node plus
# unified operator CLI; comparison tooling is built only when ALPACA_DOCKER_BUILD_TOOLS=true.
ALPACA_DOCKER_CARGO_PROFILE=release-rollout
ALPACA_DOCKER_BUILD_TOOLS=false
CARGO_BUILD_JOBS=1

# Compose-local Postgres defaults.
POSTGRES_DB=nautilus
POSTGRES_USER=nautilus
POSTGRES_PASSWORD=pass
ALPACA_POSTGRES_PORT=55432
NAUTILUS_OPERATIONAL_SCHEMA=trading_ops
NAUTILUS_ALPACA_DOCKER_ACCOUNT=paper-main
NAUTILUS_OPERATIONAL_ACCOUNT_ID=paper-main
NAUTILUS_ALPACA_DOCKER_SERVICE=alpaca-options-container
# Defaults use the checked safe examples. Point these at reviewed local configs for paper trading.
# NAUTILUS_ALPACA_DOCKER_BASE_CONFIG=/home/ade/.config/nautilus-trader/alpaca/base-options.toml
# NAUTILUS_ALPACA_DOCKER_CONFIG=/home/ade/.config/nautilus-trader/alpaca/options.toml

# Default Docker posture is read-only / blocked. Override only for an intentional paper run.
ALPACA_OPEN_ORDERS=false
ALPACA_CLOSE_ORDERS=false
ALPACA_FORCE_FLATTEN=false
ALPACA_CANCEL_AFTER_ACCEPT=false
# Optional Docker-only overrides when the container must differ from the shared repo .env.
# NAUTILUS_ALPACA_DOCKER_OPEN_ORDERS=false
# NAUTILUS_ALPACA_DOCKER_CLOSE_ORDERS=false
# NAUTILUS_ALPACA_DOCKER_FORCE_FLATTEN=false
# NAUTILUS_ALPACA_DOCKER_CANCEL_AFTER_ACCEPT=false

# Optional one-shot/dry-run overrides.
# ALPACA_STRATEGY_FAMILIES=iron_condor
# ALPACA_DRY_RUN_FAMILIES=iron_condor
# ALPACA_MAX_ITERATIONS=1
# ALPACA_IGNORE_ENTRY_WINDOW=true
# ALPACA_ACTIVE_RISK_CANDIDATE_QUOTE_LIMIT=5
# ALPACA_ACTIVE_RISK_QUOTE_STALE_SECS=30
# ALPACA_LIFECYCLE_POLL_SECS=300
# ALPACA_LIFECYCLE_ACTIVITY_LOOKBACK_HOURS=72
# ALPACA_LIFECYCLE_ACTIVITY_BLOCK_HOURS=24
# ALPACA_EXPIRATION_ENTRY_BLOCK_DAYS=0

# Optional repo-level market-data dual-write. Keep disabled until ClickHouse migrations are applied
# and the warehouse endpoint is reachable from the Alpaca container.
NAUTILUS_MARKET_DATA_DUAL_WRITE=false
NAUTILUS_MARKET_DATA_CATALOG_URI=/state/catalog
NAUTILUS_MARKET_DATA_WAREHOUSE_SOURCE=alpaca-live
NAUTILUS_MARKET_DATA_WAREHOUSE_BATCH_SIZE=100
NAUTILUS_MARKET_DATA_WAREHOUSE_FLUSH_MS=1000
NAUTILUS_MARKET_DATA_WAREHOUSE_QUEUE_CAPACITY=10000
CLICKHOUSE_URL=http://host.docker.internal:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
# Canonical market-data database. Migration metadata remains in warehouse.schema_migrations.
CLICKHOUSE_DATABASE=market
