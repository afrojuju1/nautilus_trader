# Copy this file outside the repo before use, for example:
#   mkdir -p ~/.config/nautilus-trader/alpaca
#   cp deploy/alpaca/alpaca-index-credit.env.example ~/.config/nautilus-trader/alpaca/index-credit.env
#   chmod 600 ~/.config/nautilus-trader/alpaca/index-credit.env
#
# Do not commit real credentials.

# Alpaca paper credentials.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Paper endpoints by default. Change only when intentionally moving to live.
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_TRADE_UPDATES_WS_URL=wss://paper-api.alpaca.markets/stream

# Repo and runtime paths.
NAUTILUS_ALPACA_REPO=/home/ade/Projects/nautilus_trader
NAUTILUS_ALPACA_LOG_DIR=/home/ade/.local/state/nautilus_trader/logs
NAUTILUS_ALPACA_LOCK_DIR=/home/ade/.local/state/nautilus_trader/locks
ALPACA_INDEX_PUT_CREDIT_STATE_PATH=/home/ade/.local/state/nautilus_trader/alpaca_index_put_credit_entry_state.json

# Strategy universe and cadence.
ALPACA_INDEX_PUT_CREDIT_UNDERLYINGS=SPY,QQQ,IWM,DIA,GLD
ALPACA_INDEX_CREDIT_STRATEGIES=put
# 0 means run continuously for service mode. Set to 1 for one-shot smoke tests.
ALPACA_INDEX_PUT_CREDIT_MAX_ITERATIONS=0
ALPACA_INDEX_PUT_CREDIT_INTERVAL_SECS=300
ALPACA_INDEX_PUT_CREDIT_ENTRY_START=09:45
ALPACA_INDEX_PUT_CREDIT_ENTRY_END=14:30
ALPACA_INDEX_PUT_CREDIT_ENTRY_TZ=America/New_York

# Scanner parameters.
ALPACA_PUT_CREDIT_MIN_DTE=5
ALPACA_PUT_CREDIT_MAX_DTE=10
ALPACA_PUT_CREDIT_SHORT_DELTA_MIN=0.18
ALPACA_PUT_CREDIT_SHORT_DELTA_MAX=0.28
ALPACA_PUT_CREDIT_WIDTHS=2,3,5
ALPACA_PUT_CREDIT_MIN_OPEN_INTEREST=200
ALPACA_PUT_CREDIT_MAX_LEG_SPREAD_PCT=0.15
ALPACA_PUT_CREDIT_MIN_RETURN_ON_RISK=0.13

# Safety gates. Defaults are dry-run/manage-observe only.
ALPACA_INDEX_PUT_CREDIT_SUBMIT=false
ALPACA_INDEX_CREDIT_MANAGE=false
ALPACA_INDEX_CREDIT_CLOSE=false
ALPACA_INDEX_CREDIT_KILL_SWITCH=true
ALPACA_INDEX_CREDIT_FORCE_FLATTEN=false

# Management thresholds.
ALPACA_INDEX_CREDIT_STALE_ENTRY_SECS=900
ALPACA_INDEX_CREDIT_PROFIT_TARGET_CLOSE_FRACTION=0.50
ALPACA_INDEX_CREDIT_STOP_LOSS_CLOSE_MULTIPLE=2.0
ALPACA_INDEX_CREDIT_MAX_HOLD_SECS=0
ALPACA_INDEX_CREDIT_EXPIRATION_EXIT_DAYS=1
