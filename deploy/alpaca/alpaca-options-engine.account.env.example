# Copy to ~/.config/nautilus-trader/alpaca/accounts/<account-id>.env.
#
# This template is for account-scoped systemd instances such as:
#   alpaca-options@paper-directional.service
#   alpaca-options@paper-put-credit-spy.service
#   alpaca-options@paper-call-credit-qqq.service
#   alpaca-options@paper-undefined-risk.service
#
# The systemd template owns account identity, service name, config path, log path, and lock path.
# Keep this file focused on credentials, endpoints, and explicit safety gates.
#
# Do not commit real credentials.

ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Paper endpoints by default. Change only when intentionally moving this account to live.
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_TRADE_UPDATES_WS_URL=wss://paper-api.alpaca.markets/stream

# Keep additional accounts inert until intentionally enabled.
ALPACA_SUBMIT=false
ALPACA_MANAGE=false
ALPACA_CLOSE=false
ALPACA_KILL_SWITCH=true
ALPACA_FORCE_FLATTEN=false
ALPACA_CANCEL_AFTER_ACCEPT=false

# Optional manual CLI overrides. The systemd template supplies these for normal service runs.
# NAUTILUS_ALPACA_ACCOUNT=paper-put-credit-spy
# NAUTILUS_ALPACA_SERVICE=alpaca-options@paper-put-credit-spy.service
# NAUTILUS_ALPACA_REPO=/home/ade/Projects/nautilus_trader
# NAUTILUS_ALPACA_RUNNER_BIN=/home/ade/.local/bin/alpaca-options-engine
# NAUTILUS_ALPACA_OPERATOR_BIN=/home/ade/.local/bin/alpaca-operator-status
# NAUTILUS_ALPACA_LOG_DIR=/home/ade/.local/state/nautilus_trader/alpaca/paper-put-credit-spy/logs
# NAUTILUS_ALPACA_LOCK_DIR=/home/ade/.local/state/nautilus_trader/alpaca/paper-put-credit-spy/locks
# ALPACA_CONFIG_PATH=/home/ade/.config/nautilus-trader/alpaca/configs/paper-put-credit-spy-options-engine.toml
