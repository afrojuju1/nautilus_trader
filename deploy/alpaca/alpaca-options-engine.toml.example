# Copy to ~/.config/nautilus-trader/alpaca/options-engine.toml before running the service.
# Shared scanner, universe, sector, and management defaults live in base-options-engine.toml.

extends = "base-options-engine.toml"

[runtime]
strategies = ["put"]
dry_run_strategies = []
submit = false
manage = false
close = false
kill_switch = true
state_path = "/home/ade/.local/state/nautilus_trader/alpaca_options_engine_state.json"

[risk]
# Account-level caps checked before any hosted strategy can submit a new entry.
# Omit a field or set it through env only when the cap should be unlimited.
max_active_entries = 1
max_daily_submits = 1
max_open_orders = 1
max_active_entries_per_sector = 3
