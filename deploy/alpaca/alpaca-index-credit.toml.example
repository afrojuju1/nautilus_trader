# Copy to ~/.config/nautilus-trader/alpaca/index-credit.toml before running the service.

[runtime]
strategies = ["put"]
dry_run_strategies = []
# 0 means run continuously for service mode. Set to 1 for one-shot smoke tests.
max_iterations = 0
interval_secs = 300
submit = false
manage = false
close = false
kill_switch = true
force_flatten = false
cancel_after_accept = false
ignore_entry_window = false
state_path = "/home/ade/.local/state/nautilus_trader/alpaca_index_credit_state.json"

[index]
underlyings = ["SPY", "QQQ", "IWM", "DIA", "GLD"]
quantity = 1
entry_start = "09:45"
entry_end = "14:30"
entry_timezone = "America/New_York"

[scanner]
min_dte = 5
max_dte = 10
short_delta_min = 0.18
short_delta_max = 0.28
widths = [2.0, 3.0, 5.0]
min_open_interest = 200
max_leg_spread_pct = 0.15
min_return_on_risk = 0.13
min_credit_to_width = 0.08

[iron_condor]
min_return_on_risk = 0.18
wing_min_return_on_risk = 0.10
require_equal_widths = true

[debit_scanner]
min_dte = 5
max_dte = 45
long_delta_min = 0.45
long_delta_max = 0.65
widths = [2.0, 3.0, 5.0]
min_open_interest = 200
max_leg_spread_pct = 0.15
max_debit_to_width = 0.55
min_debit_to_width = 0.20
min_reward_to_risk = 0.75

[naked_scanner]
min_dte = 7
max_dte = 21
short_delta_min = 0.10
short_delta_max = 0.20
min_open_interest = 500
max_spread_pct = 0.12
min_credit = 0.25

[risk]
# Account-level caps checked before any hosted strategy can submit a new entry.
# Omit a field or set it through env only when the cap should be unlimited.
max_active_entries = 1
max_daily_submits = 1
max_open_orders = 1
max_active_entries_per_underlying = 1
max_active_entries_per_sector = 3

[risk.sectors]
SPY = "broad_index"
QQQ = "broad_index"
IWM = "broad_index"
DIA = "broad_index"
GLD = "metals"
TLT = "rates"
XLE = "energy"
XLF = "financials"
XLK = "technology"
XLV = "healthcare"

[management]
stale_entry_secs = 900
stale_close_secs = 120
close_regular_hours_only = true
close_start = "09:30"
close_end = "16:00"
close_price_cushion = 0.02
max_close_attempts = 3
close_reprice_cooldown_secs = 30
profit_target_close_fraction = 0.50
stop_loss_close_multiple = 2.0
max_hold_secs = 0
expiration_exit_days = 1
