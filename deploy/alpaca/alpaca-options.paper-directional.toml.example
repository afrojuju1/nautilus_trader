# Copy to ~/.config/nautilus-trader/alpaca/configs/paper-directional-options.toml.
# Profile manifest: deploy/alpaca/alpaca-paper-profiles.tsv profile_id=defined_risk_credit_watchlist.
# Defined-risk watchlist account. Scans approved credit profiles but does not submit.

extends = "../base-options.toml"

[runtime]
open_orders = false
close_orders = true
state_path = "/home/ade/.local/state/nautilus_trader/alpaca/paper-directional/strategy_state.json"

[[strategies]]
id = "put_credit_spy_watch"
family = "put_credit"
mode = "dry_run"
underlyings = ["SPY"]
quantity = 1

[strategies.scanner]
min_return_on_risk = 0.16

[[strategies]]
id = "call_credit_qqq_watch"
family = "call_credit"
mode = "dry_run"
underlyings = ["QQQ"]
quantity = 1

[strategies.scanner]
min_return_on_risk = 0.16

[universe]
entry_start = "09:45"
entry_end = "10:15"

[management]
profit_target_close_fraction = 0.50
stop_loss_close_multiple = 2.0
max_hold_secs = 14400
expiration_exit_days = 1

[risk]
max_active_entries = 2
max_daily_submits = 1
max_open_orders = 2
max_active_entries_per_underlying = 1
max_active_entries_per_sector = 2
