# Copy this file to the repo-local .env before use:
#   cp deploy/alpaca/alpaca-options.env.example .env
#   chmod 600 .env
#
# Do not commit real credentials.

# Alpaca paper credentials.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Paper endpoints by default. Change only when intentionally moving to live.
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_TRADE_UPDATES_WS_URL=wss://paper-api.alpaca.markets/stream

# Repo and runtime paths.
NAUTILUS_ALPACA_SERVICE=alpaca-options.service
NAUTILUS_ALPACA_REPO=/home/ade/Projects/nautilus_trader
NAUTILUS_ALPACA_RUNNER_BIN=/home/ade/.local/bin/alpaca-options-node
NAUTILUS_ALPACA_OPERATOR_BIN=/home/ade/.local/bin/alpaca-ops
NAUTILUS_ALPACA_LOG_DIR=/home/ade/.local/state/nautilus_trader/logs
NAUTILUS_ALPACA_LOCK_DIR=/home/ade/.local/state/nautilus_trader/locks
ALPACA_CONFIG_PATH=/home/ade/.config/nautilus-trader/alpaca/options.toml

# Emergency overrides. Strategy parameters live in ALPACA_CONFIG_PATH.
ALPACA_SUBMIT=false
ALPACA_MANAGE=false
ALPACA_CLOSE=false
ALPACA_KILL_SWITCH=true
ALPACA_FORCE_FLATTEN=false
ALPACA_CANCEL_AFTER_ACCEPT=false

# Optional one-shot/dry-run overrides.
# ALPACA_STRATEGY_FAMILIES=iron_condor
# ALPACA_DRY_RUN_FAMILIES=iron_condor
# ALPACA_MAX_ITERATIONS=1
# ALPACA_IGNORE_ENTRY_WINDOW=true
# ALPACA_MAX_ACTIVE_ENTRIES=1
# ALPACA_MAX_DAILY_SUBMITS=1
# ALPACA_MAX_OPEN_ORDERS=1
# ALPACA_MAX_ACTIVE_ENTRIES_PER_UNDERLYING=1
# ALPACA_MAX_ACTIVE_ENTRIES_PER_SECTOR=3
# ALPACA_CLOSE_REGULAR_HOURS_ONLY=true
# ALPACA_CLOSE_PRICE_CUSHION=0.02
# ALPACA_MAX_CLOSE_ATTEMPTS=3
# ALPACA_CLOSE_REPRICE_COOLDOWN_SECS=30
# ALPACA_ACTIVE_RISK_CANDIDATE_QUOTE_LIMIT=5
# ALPACA_ACTIVE_RISK_QUOTE_STALE_SECS=30
# ALPACA_LIFECYCLE_POLL_SECS=300
# ALPACA_LIFECYCLE_ACTIVITY_LOOKBACK_HOURS=72
# ALPACA_LIFECYCLE_ACTIVITY_BLOCK_HOURS=24
# ALPACA_EXPIRATION_ENTRY_BLOCK_DAYS=0
