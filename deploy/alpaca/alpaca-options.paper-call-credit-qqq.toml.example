# Copy to ~/.config/nautilus-trader/alpaca/configs/paper-call-credit-qqq-options.toml.
# Profile manifest: deploy/alpaca/alpaca-paper-profiles.tsv profile_id=call_credit_qqq_strict backtest_profile=call_credit_qqq_strict.
# Isolated paper profile for the QQQ call-credit candidate selected from focused sweeps.

extends = "../base-options.toml"

[runtime]
open_orders = true
close_orders = true
state_path = "/home/ade/.local/state/nautilus_trader/alpaca/paper-call-credit-qqq/strategy_state.json"

[[strategies]]
id = "call_credit_qqq_strict"
family = "call_credit"
mode = "live"
underlyings = ["QQQ"]
quantity = 1

[strategies.scanner]
min_return_on_risk = 0.20

[universe]
entry_start = "09:45"
entry_end = "10:15"

[management]
profit_target_close_fraction = 0.50
stop_loss_close_multiple = 2.0
max_hold_secs = 14400
expiration_exit_days = 1

[risk]
max_active_entries = 1
max_daily_submits = 1
max_open_orders = 2
max_active_entries_per_underlying = 1
max_active_entries_per_sector = 1
