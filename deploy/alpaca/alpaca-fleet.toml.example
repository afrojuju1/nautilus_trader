# Copy to ~/.config/nautilus-trader/alpaca/fleet.toml.
#
# This registry is operator/control-plane metadata only. Accounts use the shared repo `.env`
# unless an account intentionally sets `env_file` to a different boundary.

[fleet]
operator_bin = "/home/ade/.local/bin/nautilus"
kill_switch = false
max_active_entries = 18
max_active_entries_per_underlying = 2
max_active_entries_per_sector = 6

[fleet.sectors]
SPY = "broad_index"
QQQ = "broad_index"
IWM = "broad_index"
DIA = "broad_index"
GLD = "metals"
GDX = "metals"
SLV = "metals"
TLT = "rates"
XLE = "energy"
USO = "energy"
XOP = "energy"
XOM = "energy"
XLB = "materials"
XLC = "communication_services"
XLF = "financials"
XLK = "technology"
XLV = "healthcare"
XLY = "consumer_discretionary"
XLI = "industrials"
XLP = "consumer_staples"
XLU = "utilities"
SMH = "semiconductors"

[[accounts]]
id = "paper-main"
role = "defined_risk_short_premium"
enabled = true
service = "alpaca-options.service"
config_file = "/home/ade/.config/nautilus-trader/alpaca/options.toml"
log_dir = "/home/ade/.local/state/nautilus_trader/logs"
lock_dir = "/home/ade/.local/state/nautilus_trader/locks"
state_path = "/home/ade/.local/state/nautilus_trader/alpaca_options_state.json"

[accounts.permissions]
defined_risk = true
long_premium = false
undefined_risk = false
naked_calls = false
naked_puts = false

[accounts.risk_budget]
max_active_entries = 10
max_buying_power_pct = 0.10
max_notional_risk = 5000.0

[[accounts]]
id = "paper-directional"
role = "defined_risk_watchlist"
enabled = true
service = "alpaca-options@paper-directional.service"
config_file = "/home/ade/.config/nautilus-trader/alpaca/configs/paper-directional-options.toml"
log_dir = "/home/ade/.local/state/nautilus_trader/alpaca/paper-directional/logs"
lock_dir = "/home/ade/.local/state/nautilus_trader/alpaca/paper-directional/locks"
state_path = "/home/ade/.local/state/nautilus_trader/alpaca/paper-directional/strategy_state.json"

[accounts.permissions]
defined_risk = true
long_premium = false
undefined_risk = false
naked_calls = false
naked_puts = false

[accounts.risk_budget]
max_active_entries = 3
max_buying_power_pct = 0.05
max_notional_risk = 2500.0

[[accounts]]
id = "paper-put-credit-spy"
role = "defined_risk_put_credit_spy"
enabled = true
service = "alpaca-options@paper-put-credit-spy.service"
config_file = "/home/ade/.config/nautilus-trader/alpaca/configs/paper-put-credit-spy-options.toml"
log_dir = "/home/ade/.local/state/nautilus_trader/alpaca/paper-put-credit-spy/logs"
lock_dir = "/home/ade/.local/state/nautilus_trader/alpaca/paper-put-credit-spy/locks"
state_path = "/home/ade/.local/state/nautilus_trader/alpaca/paper-put-credit-spy/strategy_state.json"

[accounts.permissions]
defined_risk = true
long_premium = false
undefined_risk = false
naked_calls = false
naked_puts = false

[accounts.risk_budget]
max_active_entries = 1
max_buying_power_pct = 0.03
max_notional_risk = 1500.0

[[accounts]]
id = "paper-call-credit-qqq"
role = "defined_risk_call_credit_qqq"
enabled = true
service = "alpaca-options@paper-call-credit-qqq.service"
config_file = "/home/ade/.config/nautilus-trader/alpaca/configs/paper-call-credit-qqq-options.toml"
log_dir = "/home/ade/.local/state/nautilus_trader/alpaca/paper-call-credit-qqq/logs"
lock_dir = "/home/ade/.local/state/nautilus_trader/alpaca/paper-call-credit-qqq/locks"
state_path = "/home/ade/.local/state/nautilus_trader/alpaca/paper-call-credit-qqq/strategy_state.json"

[accounts.permissions]
defined_risk = true
long_premium = false
undefined_risk = false
naked_calls = false
naked_puts = false

[accounts.risk_budget]
max_active_entries = 1
max_buying_power_pct = 0.03
max_notional_risk = 1500.0

[[accounts]]
id = "paper-undefined-risk"
role = "undefined_risk_short_premium"
enabled = true
service = "alpaca-options@paper-undefined-risk.service"
config_file = "/home/ade/.config/nautilus-trader/alpaca/configs/paper-undefined-risk-options.toml"
log_dir = "/home/ade/.local/state/nautilus_trader/alpaca/paper-undefined-risk/logs"
lock_dir = "/home/ade/.local/state/nautilus_trader/alpaca/paper-undefined-risk/locks"
state_path = "/home/ade/.local/state/nautilus_trader/alpaca/paper-undefined-risk/strategy_state.json"

[accounts.permissions]
defined_risk = false
long_premium = false
undefined_risk = true
naked_calls = true
naked_puts = true

[accounts.risk_budget]
max_active_entries = 4
max_buying_power_pct = 0.03
max_notional_risk = 1500.0
max_delta_abs = 50.0
max_gamma_abs = 20.0
max_vega_abs = 100.0
