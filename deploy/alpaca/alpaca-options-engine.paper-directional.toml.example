# Copy to ~/.config/nautilus-trader/alpaca/configs/paper-directional-options-engine.toml.
# Defined-risk watchlist account. Scans approved credit profiles but does not submit.

extends = "../base-options-engine.toml"

[runtime]
strategies = ["put_credit", "call_credit"]
dry_run_strategies = ["put_credit", "call_credit"]
submit = true
manage = true
close = true
kill_switch = false
state_path = "/home/ade/.local/state/nautilus_trader/alpaca/paper-directional/strategy_state.json"

[universe]
underlyings = ["SPY", "QQQ"]
entry_start = "09:45"
entry_end = "10:15"

[scanner]
min_return_on_risk = 0.16

[management]
profit_target_close_fraction = 0.50
stop_loss_close_multiple = 2.0
max_hold_secs = 14400
expiration_exit_days = 1

[risk]
max_active_entries = 2
max_daily_submits = 1
max_open_orders = 2
max_active_entries_per_underlying = 1
max_active_entries_per_sector = 2
