# Copy to ~/.config/nautilus-trader/alpaca/options.toml before running the base service.
# Shared scanner, universe, sector, and management defaults live in base-options.toml.
# Profile manifest: deploy/alpaca/alpaca-paper-profiles.tsv profile_id=iron_condor_watchlist backtest_profile=iron_condor_spy_sweep.
# This base account keeps iron condors in watchlist mode while still managing existing state.

extends = "base-options.toml"

[runtime]
open_orders = false
close_orders = true
state_path = "/home/ade/.local/state/nautilus_trader/alpaca_options_state.json"

[[strategies]]
id = "iron_condor_watchlist"
family = "iron_condor"
mode = "dry_run"
underlyings = ["SPY", "QQQ", "IWM", "DIA", "GLD", "GDX", "SLV", "TLT", "XLE", "XLF", "XLK", "XLV", "XLY", "XLI", "XLP", "XLU", "XLB", "XLC", "SMH", "USO", "XOP", "XOM"]
quantity = 1

[universe]
entry_start = "10:00"
entry_end = "13:30"

[scanner]
short_delta_min = 0.10
short_delta_max = 0.18
min_open_interest = 500
max_leg_spread_pct = 0.08
min_return_on_risk = 0.10
min_credit_to_width = 0.06

[iron_condor]
min_return_on_risk = 0.12
wing_min_return_on_risk = 0.08
require_equal_widths = true

[risk]
max_active_entries = 6
max_daily_submits = 4
max_open_orders = 6
max_active_entries_per_underlying = 2
max_active_entries_per_sector = 4

[management]
profit_target_close_fraction = 0.60
stop_loss_close_multiple = 1.60
max_hold_secs = 172800
expiration_exit_days = 2
