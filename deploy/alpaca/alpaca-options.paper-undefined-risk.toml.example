# Copy to ~/.config/nautilus-trader/alpaca/configs/paper-undefined-risk-options.toml.
# Profile manifest: deploy/alpaca/alpaca-paper-profiles.tsv profile_id=undefined_risk_short_premium.
# Isolated undefined-risk paper account. Keep separate from defined-risk profile validation.

extends = "../base-options.toml"

[runtime]
strategy_families = ["naked_call", "naked_put", "naked_call_1_3dte", "naked_put_1_3dte"]
dry_run_families = []
submit = true
manage = true
close = true
kill_switch = false
state_path = "/home/ade/.local/state/nautilus_trader/alpaca/paper-undefined-risk/strategy_state.json"

[naked_scanner]
max_buying_power_usage_pct = 0.03

[naked_1_3dte_scanner]
max_buying_power_usage_pct = 0.03

[risk]
max_active_entries = 4
max_daily_submits = 2
max_open_orders = 4
max_active_entries_per_underlying = 2
max_active_entries_per_sector = 2
